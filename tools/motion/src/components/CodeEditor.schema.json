{
  "title": "CodeEditor",
  "description": "Dark code editor typing lines, plus a DAY n counter from dayFrom to dayTo.",
  "x-layout": "float",
  "examples": [{"file": "budget.py", "lines": ["total = 0", "for item in spending:", "    total += item"], "dayLabel": "Day"}],
  "type": "object",
  "required": [
    "file",
    "lines"
  ],
  "properties": {
    "file": {
      "type": "string",
      "x-text": true,
      "maxLength": 30
    },
    "lines": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "x-text": true
    },
    "dayLabel": {
      "type": "string",
      "x-text": true,
      "maxLength": 20,
      "default": "DÍA"
    },
    "dayFrom": {
      "type": "number"
    },
    "dayTo": {
      "type": "number"
    },
    "countStart": {
      "type": "number",
      "x-time": "event",
      "default": 0.3
    },
    "countEnd": {
      "type": "number",
      "x-time": "event",
      "default": 2
    }
  },
  "x-cues": [
    {
      "path": "countEnd",
      "default": 2,
      "entrance": {
        "frames": 0
      }
    }
  ]
}
