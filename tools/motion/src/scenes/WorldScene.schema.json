{
  "title": "WorldScene",
  "description": "A continuous world under a moving camera (storyboard engine merges WorldScene beats).",
  "x-layout": "full",
  "type": "object",
  "required": [
    "world"
  ],
  "properties": {
    "grain": {
      "type": "number"
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "t",
          "emph",
          "phrase"
        ],
        "properties": {
          "text": {
            "type": "string",
            "x-text": true
          },
          "t": {
            "type": "number",
            "x-time": "event"
          },
          "emph": {
            "type": "boolean"
          },
          "phrase": {
            "type": "number"
          }
        }
      }
    },
    "headline": {
      "type": "boolean"
    },
    "world": {
      "type": [
        "object",
        "string"
      ],
      "required": [
        "objects"
      ],
      "properties": {
        "terrain": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "snow"
              ]
            },
            "slope": {
              "type": "number"
            }
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true,
