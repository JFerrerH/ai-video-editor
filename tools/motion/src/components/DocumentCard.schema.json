{
  "title": "DocumentCard",
  "description": "Big year stamp plus a paper document card.",
  "x-layout": "float",
  "examples": [{"year": "2024", "kicker": "Report", "title": "How people save\nwhen prices rise", "author": "A. Writer"}],
  "type": "object",
  "required": [
    "kicker",
    "title"
  ],
  "properties": {
    "year": {
      "type": "string",
      "x-text": true,
      "maxLength": 6
    },
    "kicker": {
      "type": "string",
      "x-text": true,
      "maxLength": 26
    },
    "title": {
      "type": "string",
      "x-text": true,
      "maxLength": 40
    },
    "emphasis": {
      "type": "string",
      "description": "substring of title set in the accent colour"
    },
    "author": {
      "type": "string",
      "x-text": true,
      "maxLength": 30
    },
    "cardAt": {
      "type": "number",
      "x-time": "event",
      "default": 0.35
    },
    "enterFrom": {
      "type": "string",
      "enum": [
        "below",
        "above"
      ],
      "default": "below"
    }
  },
  "x-cues": [
    {
      "path": "cardAt",
      "default": 0.35,
      "entrance": {
        "frames": 14
      }
    }
  ]
}
