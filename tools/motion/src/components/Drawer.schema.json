{
  "title": "Drawer",
  "description": "A document drops into a drawer that slams shut at closeAt.",
  "x-layout": "float",
  "examples": [{"docTitle": "Old plan", "closeAt": 1.0}],
  "type": "object",
  "required": [
    "docTitle",
    "closeAt"
  ],
  "properties": {
    "docTitle": {
      "type": "string",
      "x-text": true,
      "maxLength": 40
    },
    "closeAt": {
      "type": "number",
      "x-time": "event"
    }
  },
  "x-cues": [
    {
      "path": "closeAt",
      "entrance": {
        "frames": 6
      }
    }
  ],
  "x-still-before": "closeAt"
}
