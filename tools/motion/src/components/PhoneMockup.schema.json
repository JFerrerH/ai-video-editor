{
  "title": "PhoneMockup",
  "description": "Phone with product screens swiping in at their at, or a scrolling page capture.",
  "x-layout": "float",
  "examples": [{"screens": [{"src": "sample.png", "at": 0.0, "label": "Home"}]}],
  "type": "object",
  "properties": {
    "variant": {
      "type": "string",
      "enum": [
        "center",
        "side"
      ],
      "default": "center"
    },
    "side": {
      "type": "string",
      "enum": [
        "left",
        "right"
      ],
      "default": "left"
    },
    "screens": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "src",
          "at"
        ],
        "properties": {
          "src": {
            "type": "string",
            "description": "a staged public file (short.json public_files / storyboard assets)"
          },
          "at": {
            "type": "number",
            "x-time": "event"
          },
          "label": {
            "type": "string",
            "x-text": true,
            "maxLength": 20
          }
        }
      }
    },
    "scroll": {
      "type": "object",
      "required": [
        "src",
        "srcWidth",
        "from",
        "to",
        "start",
        "end"
      ],
      "properties": {
        "src": {
          "type": "string",
          "description": "a staged public file (short.json public_files / storyboard assets)"
        },
        "srcWidth": {
          "type": "number"
        },
        "from": {
          "type": "number",
          "description": "source px"
        },
        "to": {
          "type": "number",
          "description": "source px"
        },
        "start": {
          "type": "number",
          "x-time": "event"
        },
        "end": {
          "type": "number",
          "x-time": "event"
        },
        "url": {
          "type": "string",
          "x-text": true,
          "maxLength": 40
        }
      }
    }
  },
  "x-cues": [
    {
      "path": "screens[].at",
      "entrance": {
        "frames": 8
      }
    }
  ]
}
