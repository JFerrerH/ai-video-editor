{
  "title": "FrameworkCard",
  "description": "Kicker plus numbered steps built up stepGap apart from stepsAt; flash at flashAt.",
  "x-layout": "float",
  "type": "object",
  "required": [
    "steps"
  ],
  "properties": {
    "kicker": {
      "type": "string",
      "x-text": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "lines"
        ],
        "properties": {
          "title": {
            "type": "string",
            "x-text": true
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "x-text": true
          }
        }
      }
    },
    "stepsAt": {
      "type": "number",
      "x-time": "event",
      "default": 0.25
    },
    "stepGap": {
      "type": "number",
      "x-time": "duration",
      "minimum": 0,
      "default": 0.3
    },
    "flashAt": {
      "type": "number",
      "x-time": "event"
    },
    "layout": {
      "type": "string",
      "enum": [
        "list",
        "grid"
      ],
      "default": "list"
    },
    "top": {
      "type": "number",
      "minimum": -400,
      "maximum": 1920,
      "description": "px from the top of the 1080x1920 frame"
    }
  },
  "x-cues": [
    {
      "path": "steps[].at",
      "default": {
        "first": 0.25,
        "step": 0.3,
        "first_prop": "stepsAt",
        "step_prop": "stepGap"
      },
      "entrance": {
        "frames": 14
      }
    },
    {
      "path": "flashAt",
      "entrance": {
        "frames": 8
      }
    }
  ]
}
