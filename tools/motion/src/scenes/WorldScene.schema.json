        "type": "object",
        "required": [
          "at",
          "target",
          "do"
        ],
        "properties": {
          "at": {
            "type": "number",
            "x-time": "event"
          },
          "target": {
            "type": "string"
          },
          "do": {
            "type": "string"
          },
          "to": {
            "type": [
              "string",
              "number"
            ]
          },
          "arrive": {
            "type": "number",
            "x-time": "event"
          },
          "dur": {
            "type": "number",
            "x-time": "duration"
          },
          "by": {
            "type": "number"
          },
          "v": {
            "type": "number"
          },
          "chip": {
            "type": "string"
          },
          "into": {
            "type": "string"
          },
          "dx": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          },
          "pose": {
            "type": "string",
            "enum": [
              "stand",
              "wave",
              "cheer",
              "point",
              "shrug",
              "slump",
              "think",
              "type",
              "push",
              "shout",
              "read",
              "wait",
              "reach",
              "scared",
              "walk"
            ]
          },
          "prop": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "desk",
              "megaphone",
              "box",
              "book",
              "phone",
              "bag",
              null
            ]
          },
          "x": {
            "type": "number"
          },
          "item": {
            "type": "string"
          },
          "on": {
            "type": "string"
          },
          "follow": {
            "type": "string"
          },
          "zoom": {
            "type": "number"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
