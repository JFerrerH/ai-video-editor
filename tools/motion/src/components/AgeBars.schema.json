{
  "title": "AgeBars",
  "description": "Ratio bars (×1 / ×2 / ×3) that grow on cue, floating above the head.",
  "x-layout": "float",
  "examples": [{"bars": [{"value": 62, "label": "18–24", "at": 0.2}, {"value": 48, "label": "25–34", "at": 0.5, "highlight": true}, {"value": 31, "label": "35–44", "at": 0.8}], "caption": "Share who save every month"}],
  "type": "object",
  "required": [
    "bars"
  ],
  "properties": {
    "bars": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "value",
          "label",
          "at"
        ],
        "properties": {
          "value": {
            "type": "number"
          },
          "label": {
            "type": "string",
            "x-text": true,
            "maxLength": 20
          },
          "at": {
            "type": "number",
            "x-time": "event"
          },
          "highlight": {
            "type": "boolean"
          }
        }
      }
    },
    "caption": {
      "type": "string",
      "x-text": true,
      "maxLength": 40
    },
    "top": {
      "type": "number",
      "minimum": -400,
      "maximum": 1920,
      "description": "px from the top of the 1080x1920 frame"
    }
  },
  "x-cues": [
    {
      "path": "bars[].at",
      "entrance": {
        "frames": 14
      }
    }
  ]
}
