{
  "title": "IdCard",
  "description": "Identity card; subtitle and rows pop in on cue.",
  "x-layout": "float",
  "examples": [{"kicker": "Profile", "title": "The planner", "subtitle": "Likes a clear budget", "rows": [{"text": "Saves every payday", "at": 0.3}, {"text": "Checks once a week", "at": 0.6}]}],
  "type": "object",
  "required": [
    "title"
  ],
  "properties": {
    "kicker": {
      "type": "string",
      "x-text": true,
      "maxLength": 11
    },
    "title": {
      "type": "string",
      "x-text": true,
      "maxLength": 18
    },
    "subtitle": {
      "type": "string",
      "x-text": true,
      "maxLength": 20
    },
    "subtitleAt": {
      "type": "number",
      "x-time": "event",
      "default": 0
    },
    "rows": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "text",
          "at"
        ],
        "properties": {
          "icon": {
            "type": "string",
            "description": "pin | swap | dot | an emoji"
          },
          "text": {
            "type": "string",
            "x-text": true,
            "maxLength": 18
          },
          "at": {
            "type": "number",
            "x-time": "event"
          }
        }
      }
    },
    "top": {
      "type": "number",
      "minimum": -400,
      "maximum": 1920,
      "description": "px from the top of the 1080x1920 frame"
    },
    "width": {
      "type": "number",
      "minimum": 200,
      "maximum": 1080,
      "default": 720
    }
  },
  "x-cues": [
    {
      "path": "rows[].at",
      "entrance": {
        "frames": 14
      }
    }
  ]
}
