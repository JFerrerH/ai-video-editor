{
  "title": "Receipt",
  "description": "Quote / receipt: items tick in one by one, total, then a rubber stamp.",
  "x-layout": "float",
  "examples": [{"title": "This month", "items": [{"text": "Rent", "at": 0.2, "amount": "$900"}, {"text": "Food", "at": 0.4, "amount": "$320"}], "total": "$1,220", "stamp": "PAID", "stampAt": 0.9}],
  "type": "object",
  "required": [
    "title",
    "items",
    "total"
  ],
  "properties": {
    "title": {
      "type": "string",
      "x-text": true,
      "maxLength": 11
    },
    "items": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "text",
          "at"
        ],
        "properties": {
          "text": {
            "type": "string",
            "x-text": true,
            "maxLength": 13
          },
          "at": {
            "type": "number",
            "x-time": "event"
          },
          "amount": {
            "type": "string",
            "x-text": true,
            "maxLength": 11
          }
        }
      }
    },
    "total": {
      "type": "string",
      "x-text": true,
      "maxLength": 10
    },
    "stamp": {
      "type": "string",
      "x-text": true,
      "maxLength": 10
    },
    "stampAt": {
      "type": "number",
      "x-time": "event",
      "default": 0
    },
    "enterFrom": {
      "type": "string",
      "enum": [
        "below",
        "above"
      ],
      "default": "below"
    }
  },
  "x-cues": [
    {
      "path": "items[].at",
      "entrance": {
        "frames": 5
      }
    },
    {
      "path": "stampAt",
      "default": 0,
      "entrance": {
        "frames": 9
      }
    }
  ]
}
